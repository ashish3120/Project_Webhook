# PostgreSQL Configuration
POSTGRES_DB=webhookdb
POSTGRES_USER=webhook
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# Application Server
SERVER_PORT=8080

# Webhook Worker Configuration
WEBHOOK_WORKER_LEASE_DURATION_SECONDS=60
WEBHOOK_WORKER_BATCH_SIZE=10
WEBHOOK_WORKER_POLL_INTERVAL_MS=5000

# Retry Configuration
WEBHOOK_RETRY_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_DELAY_MS=5000
WEBHOOK_RETRY_MAX_DELAY_MS=3600000

# WebClient Timeouts
WEBHOOK_CLIENT_CONNECT_TIMEOUT_MS=5000
WEBHOOK_CLIENT_READ_TIMEOUT_MS=10000

# Allow internal/localhost endpoints (development only - never true in production)
WEBHOOK_ALLOW_INTERNAL_ENDPOINTS=false
